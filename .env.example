# Copy to .env (`make setup` does this). Never commit real secrets.
# Every variable here has a safe local default; production values come from the secret store.

# ---- API / worker (apps/api, apps/worker) ----
APP_ENV=local                 # local | test | staging | production
LOG_LEVEL=INFO
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://thiqa:thiqa@localhost:5432/thiqa
TEST_DATABASE_URL=postgresql+asyncpg://thiqa:thiqa@localhost:5432/thiqa_test
REDIS_URL=redis://localhost:6379/0

# Object storage (S3-compatible; MinIO locally). STORAGE_PROVIDER=memory runs fully offline.
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_MEDIA=thiqa-media

HEALTH_CHECK_TIMEOUT_S=2.0
# Turn on only when a proxy you control rewrites X-Forwarded-For (it feeds IP rate limiting).
TRUST_PROXY_HEADERS=false

# ---- Authentication ----
# Signs access/refresh tokens. Generate with: openssl rand -base64 48
# Must be at least 32 bytes outside local dev; the app refuses to start in production otherwise.
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000

# ---- Phone OTP login ----
# Only the mock provider exists today: it logs the code instead of sending an SMS.
# The real provider is an open decision (PROJECT_BRIEF.md §11).
SMS_PROVIDER=mock
OTP_LENGTH=6
OTP_TTL_S=300
OTP_MAX_ATTEMPTS=5
OTP_REQUESTS_PER_WINDOW=5
OTP_WINDOW_S=3600
# Local dev only: also return the code in the API response so you can log in from the web app
# without reading the logs. Refused in production.
OTP_EXPOSE_CODE=false

# ---- Web (apps/web) ----
WEB_PORT=3000
# Server-side URL the Next.js server uses to reach the API.
API_INTERNAL_URL=http://localhost:8000
# Browser-facing API URL (used once client-side calls exist).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Mobile (apps/mobile) — put these in apps/mobile/.env ----
# On a physical phone use your computer's LAN IP, e.g. http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# ---- Docker Compose host ports (change if something else is using them) ----
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ---- Added in later phases (documented here as they land) ----
# LLM_PROVIDER=mock           (Phase 2; anthropic in real envs)
# ANTHROPIC_API_KEY=          (Phase 2)
# LLM_MODEL_SMART=claude-sonnet-5
# LLM_MODEL_FAST=claude-haiku-4-5-20251001
